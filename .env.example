# Coach mode: POST /api/chat (Next.js route) uses these keys.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
OPEN_AI_API_KEY=sk-proj-your-api-key-here

# FastAPI Stage 2 RAG origin (inlined at build time). Local default: http://localhost:8000
# Production: set to your deployed API URL. Ensure FastAPI CORSMiddleware allow_origins includes this Next.js site.
NEXT_PUBLIC_API_URL=http://localhost:8000

